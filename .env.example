NODE_ENV=development
PORT=4000
DATABASE_PATH=data/rentdesk.sqlite
SESSION_SECRET=development-only-change-before-deploying
PUBLIC_APP_URL=http://localhost:5173
BUSINESS_CURRENCY=USD
PAYMENTS_MODE=demo
# For sandbox payments, set PAYMENTS_MODE=sandbox and configure your merchant accounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Production: secure HTTPS URL, a random 32+ character secret, sandbox/live mode,
# persistent database storage, and SEED_MANAGER_PASSWORD for npm run seed.
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=
TRUST_PROXY=false

# Optional external PostgreSQL (leave empty for local SQLite).
DATABASE_URL=
# Dedicated public portfolio demo only; never use with real customer data or merchant secrets.
PORTFOLIO_DEMO=false
